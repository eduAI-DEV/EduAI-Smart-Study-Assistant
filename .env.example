# EduAI Smart Study Assistant - Environment Configuration

# --- OpenAI Configuration ---
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Tavily Search Configuration ---
# Get your key from: https://tavily.com/dashboard
TAVILY_API_KEY=your_tavily_api_key_here

# --- Anthropic Configuration (Optional) ---
# Get your key from: https://console.anthropic.com/
# Only needed if you want to use Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Application Configuration ---
APP_TITLE="EduAI: Deep Research Assistant"
APP_ICON="🎓"
APP_LAYOUT="wide"

# --- Rate Limiting ---
# Maximum requests per hour
MAX_REQUESTS_PER_HOUR=100
# Maximum tokens per day
MAX_TOKENS_PER_DAY=100000

# --- Default Model ---
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet
DEFAULT_MODEL=gpt-4o

# --- Advanced Settings ---
# Temperature: Controls randomness (0.0 = deterministic, 1.0 = very random)
DEFAULT_TEMPERATURE=0.7
# Maximum tokens per response
DEFAULT_MAX_TOKENS=2048
# Number of search results to return
DEFAULT_SEARCH_RESULTS=5

# --- Logging Configuration ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log file path
LOG_FILE=eduai.log

# --- Storage Configuration ---
# Directory for saving conversations
CONVERSATIONS_DIR=conversations
# Directory for log files
LOGS_DIR=logs

# --- Security Settings ---
# Enable user authentication
ENABLE_AUTH=true
# Session timeout in minutes
SESSION_TIMEOUT=60
# Enable API key input validation
VALIDATE_API_KEYS=true

# --- Feature Flags ---
# Enable file upload feature
ENABLE_FILE_UPLOAD=true
# Enable conversation export
ENABLE_EXPORT=true
# Enable conversation history
ENABLE_HISTORY=true
# Enable cost tracking
ENABLE_COST_TRACKING=true
